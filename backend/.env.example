# Secret key for JWT tokens (required)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key

# Groq / LLM API configuration for AI Coach & NCERT-Bot (optional)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_llm_api_key_here

# Vector Database (defaults to local embedded persistent Qdrant in backend/data/qdrant_storage)
# QDRANT_URL=https://your-cluster-id.us-east.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

